# Polymarket Analyzer — environment configuration.
#
# Copy to `.env` and uncomment any settings you want to override.
# The app works fine with everything left unset — these are all optional.

# ── Market provider (which venue to fetch data from) ─────────────────────
# Available: kalshi (default — US-legal), polymarket
# MARKET_PROVIDER=kalshi

# ── Polymarket API endpoints (override only if mirroring or testing) ──────
# POLYMARKET_GAMMA_BASE=https://gamma-api.polymarket.com
# POLYMARKET_CLOB_BASE=https://clob.polymarket.com

# ── Kalshi API endpoint (override only if testing) ───────────────────────
# KALSHI_API_BASE=https://api.elections.kalshi.com/trade-api/v2
# KALSHI_HTTP_TIMEOUT=15

# ── Kalshi authenticated API (optional — enables 🏦 Live Portfolio) ──────
# Without these, the app runs read-only against Kalshi's public endpoints.
# To enable: drop your RSA private key PEM at the path below (chmod 600),
# uncomment, and fill in your key ID. Restart the app.
# KALSHI_API_KEY_ID=00000000-0000-0000-0000-000000000000
# KALSHI_PRIVATE_KEY_PATH=/home/you/.config/kalshi/private_key.pem
# Only this profile is allowed to use the authed API. Paper-trading
# profiles (sandbox, agentic_*, etc.) get a "switch profile" prompt
# instead. Default: jeff.
# KALSHI_OWNER_PROFILE=jeff
# Live trading toggle. Off by default. The Kelly Sizer's "🚀 Place real
# order" button and the Orders page's cancel buttons require this AND
# the auth gates above. Flip it ON only when you actually want to
# submit orders with real money.
# KALSHI_LIVE_ENABLED=false

# ── Autonomous live execution (execution.py LiveBroker) ───────────────────
# Lets a STRATEGY DAEMON (not just the UI) place real orders. Off by
# default and triple-gated: a daemon trades live only when its profile is
# listed here AND KALSHI_LIVE_ENABLED=true AND the active profile == the
# owner above AND emergency-stop is inactive. Prefer the go-live runbook:
#   1) point KALSHI_OWNER_PROFILE at the daemon's profile (the owner lock
#      ties the one live account to one profile — taking a daemon live
#      "claims" the account for that profile; the UI then trades live only
#      when that profile is active),
#   2) run `python live_preflight.py --profile <that profile>` (read-only),
#   3) `./go_live.sh --profile <that profile> --max-stake 2 --enable`.
# Comma-separated; empty = every daemon stays paper.
# LIVE_TRADING_PROFILES=agentic_favorite_hold
# Per-order hard cap in dollars for the LiveBroker (also pre-flight-checked).
# Set tiny for minimum-size canary testing. Default 25 if unset.
# LIVE_MAX_STAKE_DOLLARS=2
# Cents an ENTRY buy crosses the spread to take liquidity. Default 1 (cross a
# normal 1c spread). Raise for time-sensitive arms whose quoted ask drifts
# during the reaction window (0 rests at the stale ask and often never fills).
# LIVE_MARKETABLE_CROSS_CENTS=2

# ── Coinbase + Ollama (Tier 4 edge sources) ──────────────────────────────
# COINBASE_API_BASE=https://api.exchange.coinbase.com
# CRYPTO_HTTP_TIMEOUT=15
# OLLAMA_API_BASE=http://localhost:11434
# OLLAMA_HTTP_TIMEOUT=120
# LLM_CACHE_PATH=data/shared/llm_cache.sqlite
# BOOK_ARCHIVE_PATH=data/shared/book_archive.sqlite
# ESPN_API_BASE=https://site.api.espn.com/apis/site/v2
# ESPN_HTTP_TIMEOUT=15
# MANIFOLD_API_BASE=https://api.manifold.markets/v0
# MANIFOLD_HTTP_TIMEOUT=15
# FRED_GRAPH_BASE=https://fred.stlouisfed.org/graph
# FRED_HTTP_TIMEOUT=20

# HTTP request timeout in seconds (default 15)
# POLYMARKET_HTTP_TIMEOUT=15

# ── Logging ───────────────────────────────────────────────────────────────
# Log level: DEBUG, INFO (default), WARNING, ERROR
# POLYMARKET_LOG_LEVEL=INFO

# ── Storage paths (override to keep state out of the project directory) ───
# POLYMARKET_PORTFOLIO_FILE=/home/you/.config/polymarket/portfolio.json
# POLYMARKET_FORECASTS_FILE=/home/you/.config/polymarket/forecasts.json
# POLYMARKET_ALERTS_FILE=/home/you/.config/polymarket/alerts.json

# ── Drawdown circuit breaker (execution.py) ──────────────────────────────
# The breaker measures ACCOUNT-level mark-to-market equity against a
# persisted high-water mark and blocks new orders once equity falls
# further than risk.Settings.drawdown_pause_pct (default 15%) below it.
# It fails CLOSED: if equity can't be established, orders are blocked.
# Reset the peak by deleting this file (understand why it tripped first).
# LIVE_EQUITY_STATE_FILE=data/shared/live_equity.json

# ── Circuit breakers (circuit_breaker.py, P2/R-21) ───────────────────────
# Every outbound connector (Kalshi public+authed, Polymarket, ESPN, Coinbase,
# Ollama, Yahoo, Google News, Wikipedia, FRED, Manifold) fails FAST after
# this many consecutive dependency failures, for this many seconds, then
# lets one probe through. Open/close land in the health log; the daily
# digest reports an open with no recovery as a problem. An open "kalshi"
# circuit means an order is NOT placed (money path fails closed).
# CIRCUIT_FAILURE_THRESHOLD=5
# CIRCUIT_COOLDOWN_S=300

# ── Provenance (provenance.py, P2/R-18) ──────────────────────────────────
# Positions, order-audit lines, exits, backtest runs and reports carry the
# commit that produced them, read from .git. Set this only in a build that
# has no .git (container, tarball).
# PROVENANCE_COMMIT=

# ── Nightly backup (scripts/backup.sh + backup_sqlite.py) ────────────────
# Databases larger than this are SKIPPED and named in the backup log —
# this is what stops the ~43 GB retired book_archive costing a full copy
# every night. Name a file in BACKUP_FORCE_INCLUDE to back it up anyway.
# BACKUP_MAX_SQLITE_MB=2048
# BACKUP_FORCE_INCLUDE=book_archive.sqlite
# Override the destination to exercise the backup without touching the
# real tree: BACKUP_DEST_ROOT=/tmp/backup-test scripts/backup.sh
# BACKUP_DEST_ROOT=/mnt/backups/kalshi-trader

# ── Web UI access (pm/core/web_auth.py) ──────────────────────────────────
# Shared secret for the four LAN-facing web UIs (control plane + the three
# sport sidecars). With NO token configured those apps bind 127.0.0.1 only;
# setting a token makes them bind 0.0.0.0 and require it on every request
# (query ?token=, cookie, or Authorization: Bearer). This is a shared
# secret, not real authentication — do not expose these apps beyond a
# trusted network. The Streamlit console (run.sh) has NO auth at all and
# always binds loopback unless you set BIND_HOST explicitly.
# WEB_UI_TOKEN=
# Bind address override for the FastAPI apps (rarely needed; setting
# 0.0.0.0 with no token re-opens them to the whole network — don't).
# WEB_BIND_HOST=
