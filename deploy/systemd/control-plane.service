[Unit]
Description=Control plane — read-only ops dashboard over the whole fleet (FastAPI :8773)
After=network.target

# Added 2026-08-11 (P1/R-10): nothing previously reported a failure.
OnFailure=polymarket-alert@%n.service

[Service]
Type=simple
WorkingDirectory=/home/USER/Coding/kalshi-trader
ExecStart=/home/USER/Coding/kalshi-trader/.venv/bin/python -m control_plane.web
Restart=on-failure
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
