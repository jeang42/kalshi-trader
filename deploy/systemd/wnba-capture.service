[Unit]
Description=WNBA capture — measures whether the Kalshi book lags in-game win-prob swings (react-and-hold step 2)
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/USER/Coding/kalshi-trader
ExecStart=/home/USER/Coding/kalshi-trader/.venv/bin/python -m pm.capture.wnba_capture --loop --interval 30
Restart=on-failure
RestartSec=30
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
