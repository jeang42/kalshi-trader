[Unit]
Description=WNBA sidecar web UI (FastAPI on :8771)
After=network.target

# Added 2026-08-11 (P1/R-10): nothing previously reported a failure.
OnFailure=polymarket-alert@%n.service

[Service]
Type=simple
WorkingDirectory=/home/USER/Coding/kalshi-trader
ExecStart=/home/USER/Coding/kalshi-trader/.venv/bin/python -m wnba.web
Restart=on-failure
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
