[Unit]
Description=Near-close capture — accrues a clean near-close price+outcome panel for the inefficiency studies
After=network.target

# Added 2026-08-11 (P1/R-10): nothing previously reported a failure.
OnFailure=polymarket-alert@%n.service

[Service]
Type=simple
WorkingDirectory=/home/USER/Coding/kalshi-trader
ExecStart=/home/USER/Coding/kalshi-trader/.venv/bin/python -m pm.capture.near_close_capture --loop --interval 1800 --target-lead-hours 2 --min-volume 50
Restart=on-failure
RestartSec=30
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
