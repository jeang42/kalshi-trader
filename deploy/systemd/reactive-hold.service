[Unit]
Description=React-and-hold — in-game WPA reaction entry, held to resolution (validated +EV variant of the reactive arm)
After=network.target baseball-live.service kalshi-ws.service

[Service]
Type=simple
WorkingDirectory=/home/USER/Coding/kalshi-trader
ExecStart=/home/USER/Coding/kalshi-trader/.venv/bin/python -m pm.arms.reactive_scalper --hold --profile agentic_reactive_hold --base-stake 5 --high-conf-stake 10 --high-conf-depth 20000 --loop --interval 12
Restart=on-failure
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
