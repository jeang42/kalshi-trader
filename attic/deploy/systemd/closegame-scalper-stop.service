[Unit]
Description=Close-game scalper A/B arm — deep gate + -25%% stop-loss (paper)
After=network.target baseball-live.service kalshi-ws.service

[Service]
Type=simple
WorkingDirectory=/home/USER/Coding/kalshi-trader
ExecStart=/home/USER/Coding/kalshi-trader/.venv/bin/python longshot_scalper.py --mode close_game --profile agentic_closegame_scalp_stop --forecast-source deep --cg-stop-loss-pct 0.25 --loop --interval 15
Restart=on-failure
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
