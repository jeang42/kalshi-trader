[Unit]
Description=Fade-retail-longshot — forward paper arm; buy NO on overpriced longshots in arbitrageur-light retail markets (favorite-longshot fade). Idles until near-term calendar events (primaries/awards) list.
After=network.target

# Added 2026-08-11 (P1/R-10): nothing previously reported a failure.
OnFailure=polymarket-alert@%n.service

[Service]
Type=simple
WorkingDirectory=/home/USER/Coding/kalshi-trader
# Boot stagger (2026-08-17): the seven daemons all start at boot at once and
# their first discovery cycles 429'd each other on 2026-08-16. Each unit
# waits a different number of seconds so the fleet comes up spaced ~8 s
# apart without anyone at the keyboard. Also gives the network time to
# settle after boot. Applies to every start, so a manual restart of this
# unit is delayed by 40 s too — harmless.
ExecStartPre=/bin/sleep 40
ExecStart=/home/USER/Coding/kalshi-trader/.venv/bin/python fade_retail_longshot.py --loop --interval 21600
Restart=on-failure
RestartSec=60
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
