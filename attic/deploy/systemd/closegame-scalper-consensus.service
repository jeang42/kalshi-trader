[Unit]
Description=Close-game scalper A/B arm — ESPN de-vigged consensus gate (paper)
After=network.target baseball-live.service kalshi-ws.service

[Service]
Type=simple
WorkingDirectory=/home/USER/Coding/kalshi-trader
ExecStart=/home/USER/Coding/kalshi-trader/.venv/bin/python longshot_scalper.py --mode close_game --profile agentic_closegame_consensus --forecast-source consensus --loop --interval 15
Restart=on-failure
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
