[Unit]
Description=Longshot scalper (baseball in-game underdog scalp + flip + free-roll, paper)
After=network.target baseball-live.service kalshi-ws.service

[Service]
Type=simple
WorkingDirectory=/home/USER/Coding/kalshi-trader
ExecStart=/home/USER/Coding/kalshi-trader/.venv/bin/python longshot_scalper.py --loop --interval 15 --freeroll-profit
Restart=on-failure
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
